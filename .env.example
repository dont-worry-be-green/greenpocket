DB_URL=jdbc:mysql://localhost:3306/greenpocket_test?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=greenpocket
DB_PASSWORD=replace-with-local-mysql-password
SERVER_PORT=8080
ACCOUNT_NUMBER_ENCRYPTION_KEY_BASE64=replace-with-base64-encoded-32-byte-key
JWT_SECRET_BASE64=replace-with-base64-encoded-32-byte-key
JWT_ACCESS_EXPIRATION_SECONDS=1800
JWT_REFRESH_EXPIRATION_SECONDS=1209600
JWT_REFRESH_COOKIE_SECURE=false
DEMO_AUTH_ENABLED=false
CLOVA_OCR_INVOKE_URL=replace-with-apigw-invoke-url
CLOVA_OCR_SECRET=replace-with-x-ocr-secret
